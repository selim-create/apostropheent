@{ 
    string dilSecimi = HttpContext.Current.Request.RawUrl.Replace("/", "").ToLower();
    if (dilSecimi == "fr")
    {
        Languages.ChangeCulture("fr-FR");
    }
    else
    {
        Languages.ChangeCulture("en-US");
        dilSecimi = "en";
    }
}
<!DOCTYPE html>
<html lang="@dilSecimi">
<head>
    <meta charset="utf-8">
    <title>@Helper.dilGetir("meta_title")</title>
    <meta name="description" content="@Helper.dilGetir("meta_desc")" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="stylesheet" href="/assets/css/theme-core.css">
    <link rel="stylesheet" href="/assets/css/theme.css">
    <link rel="stylesheet" href="/assets/css/custom.css?v=1">
</head>
<body id="body" class="one-page alternative-font-5" data-plugin-scroll-spy data-plugin-options="{'target': '#header'}">
    <div class="body">
        <header id="header" class="header-transparent header-effect-shrink" data-plugin-options="{'stickyEnabled': true, 'stickyEffect': 'shrink', 'stickyEnableOnBoxed': true, 'stickyEnableOnMobile': true, 'stickyChangeLogo': true, 'stickyStartAt': 30, 'stickyHeaderContainerHeight': 70}">
            <div class="header-body border-top-0 bg-light box-shadow-none">
                <div class="header-container container">
                    <div class="header-row">
                        <div class="header-column">
                            <div class="header-row">
                                <div class="header-logo"><a href="/." title="@Helper.dilGetir("logo_title")"><img alt="@Helper.dilGetir("logo_title")" src="/assets/img/logo.svg" class="logo-main" /></a></div>
                            </div>
                        </div>
                        <div class="header-column justify-content-end">
                            <div class="header-row">
                                <div class="header-nav header-nav-links header-nav-dropdowns-dark header-nav-light-text order-2 order-lg-1">
                                    <div class="header-nav-main header-nav-main-font-lg header-nav-main-font-lg-upper-2 header-nav-main-mobile-dark header-nav-main-square header-nav-main-dropdown-no-borders header-nav-main-effect-2 header-nav-main-sub-effect-1">
                                        <nav class="collapse">
                                            <ul class="nav nav-pills" id="mainNav">
                                                <li><a data-hash class="nav-link active" href="#home" title="@Helper.dilGetir("menu_1")">@Helper.dilGetir("menu_1")</a></li>
                                                <li><a class="nav-link" data-hash data-hash-offset="0" data-hash-offset-lg="68" href="#aboutus" title="@Helper.dilGetir("menu_2")">@Helper.dilGetir("menu_2")</a></li>
                                                <li><a class="nav-link" data-hash data-hash-offset="0" data-hash-offset-lg="68" href="#services" title="@Helper.dilGetir("menu_3")">@Helper.dilGetir("menu_3")</a></li>
                                                <li><a class="nav-link" data-hash data-hash-offset="0" data-hash-offset-lg="68" href="#fields" title="@Helper.dilGetir("menu_4")">@Helper.dilGetir("menu_4")</a></li>
                                                <li><a class="nav-link" data-hash data-hash-offset="0" data-hash-offset-lg="68" href="#contact" title="@Helper.dilGetir("menu_5")">@Helper.dilGetir("menu_5")</a></li>
                                                <li class="dil">
                                                    <div class="dilsecimi">
                                                        <a title="@Helper.dilGetir("en_secim")" href="./" @if (dilSecimi == "en") { <text> class="aktif" </text> }>EN</a>
                                                        <a title="@Helper.dilGetir("fr_secim")" href="/fr" @if (dilSecimi == "fr") { <text> class="aktif" </text> }>FR</a>
                                                    </div>
                                                </li>
                                            </ul>
                                        </nav>
                                    </div>
                                    <button class="btn header-btn-collapse-nav" data-bs-toggle="collapse" data-bs-target=".header-nav-main nav"><i class="fas fa-bars"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>
        <div role="main" class="main">
            <section id="home">
                <div id="apostropheslider" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-touch="true">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img class="d-block w-100 d-none d-md-block" src="/assets/img/slider/apostrophe-entertainment-slider-1.jpg" alt="@Helper.dilGetir("logo_title")">
                            <img class="d-block w-100 d-xl-none d-lg-none d-md-none" src="/assets/img/slider/apostrophe-entertainment-slider-mobile-1.jpg" alt="@Helper.dilGetir("logo_title")">
                            <div class="carousel-caption">
                                <div class="baslik appear-animation" data-appear-animation="fadeInDown" data-appear-animation-delay="2.5" data-appear-animation-duration="1.5s" data-plugin-animated-letters data-plugin-options="{'startDelay': 500, 'minWindowWidth': 0, 'animationName': 'typeWriter', 'animationSpeed': 50}">
                                    @Helper.dilGetir("slider_1")
                                </div>
                            </div>
                        </div>
                        @*<div class="carousel-item">
                                <img class="d-block w-100 d-none d-md-block" src="dist/img/desktop-slider-2.jpg" alt="">
                                <img class="d-block w-100 d-xl-none d-lg-none d-md-none " src="dist/img/mobil-slider-2.jpg" alt="">
                                <div class="carousel-caption">
                                    <div class="baslik appear-animation" data-appear-animation="fadeInDown" data-appear-animation-delay="2.5" data-appear-animation-duration="1.5s" data-plugin-animated-letters data-plugin-options="{'startDelay': 500, 'minWindowWidth': 0, 'animationName': 'typeWriter', 'animationSpeed': 50}">
                                        Marketing Communications Agency for Global Entertainment and Media
                                    </div>
                                </div>
                            </div>*@
                    </div>
                    <div class="slider-social">
                        <a target="_blank" title="@Helper.dilGetir("instagram")" href="https://www.instagram.com/apostropheentertainment"><img src="/assets/img/instagram.svg" height="20" alt="@Helper.dilGetir("instagram")"></a>
                        <a target="_blank" title="@Helper.dilGetir("linkedin")" href="https://www.linkedin.com/company/apostrophe-entertainment "><img src="/assets/img/linkedin.svg" height="20" alt="@Helper.dilGetir("linkedin")"></a>
                    </div>
                    @*<button class="carousel-control-prev" type="button" data-bs-target="#apostropheslider" data-bs-slide="prev"><span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">@Helper.dilGetir("geri")</span></button>
                        <button class="carousel-control-next" type="button" data-bs-target="#apostropheslider" data-bs-slide="next"><span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">@Helper.dilGetir("ileri")</span></button>*@
                </div>
            </section>
        </div>
    </div>
    <section id="aboutus" class="py-5 border-0 m-0 appear-animation" data-appear-animation="fadeIn">
        <div class="container my-3">
            <div class="row mb-5">
                <div class="col text-center appear-animation" data-appear-animation="fadeInUpShorter" data-appear-animation-delay="200">
                    <h2 class="font-weight-semi-bold mb-2">@Helper.dilGetir("menu_2")</h2>
                </div>
            </div>
            <div class="row">
                <div class="col text-center appear-animation" data-appear-animation="fadeInLeftShorter" data-appear-animation-delay="300">
                    <p class="metin">@Helper.dilGetir("about_icerik")</p>
                </div>
            </div>
        </div>
    </section>
    <section id="services" class="py-5 border-0 m-0 appear-animation" data-appear-animation="fadeIn">
        <div class="container my-3">
            <div class="row mb-5">
                <div class="col text-center appear-animation" data-appear-animation="fadeInUpShorter" data-appear-animation-delay="200">
                    <h2 class="font-weight-semi-bold mb-2">@Helper.dilGetir("menu_3")</h2>
                </div>
            </div>
            <div class="row py-3" id="strategic-communications">
                <div class="col-lg-8 col-md-8 appear-animation align-self-center order-2 order-lg-1 order-md-1" data-appear-animation="fadeInRightShorter" data-appear-animation-delay="300">
                    <div class="services-head-1 mb-3">@Helper.dilGetir("servis_baslik_1")</div>
                    <p class="metin mb-3">@Helper.dilGetir("servis_icerik_1")</p>
                </div>
                <div class="col-lg-4 col-md-4 appear-animation align-self-center order-1 order-lg-2 order-md-2" data-appear-animation="fadeInLeftShorter" data-appear-animation-delay="300">
                    <img src="/assets/img/services/strategic-communications.gif" class="img-fluid mb-3 mt-3" alt="@Helper.dilGetir("servis_baslik_1")" />
                </div>
            </div>
            <div class="row py-3" id="digital-marketing">
                <div class="col-lg-4 col-md-4 appear-animation align-self-center order-1 order-lg-1 order-md-1" data-appear-animation="fadeInRightShorter" data-appear-animation-delay="300">
                    <img src="/assets/img/services/digital-marketing.gif" class="img-fluid mb-3 mt-3" alt="@Helper.dilGetir("servis_baslik_2")" />
                </div>
                <div class="col-lg-8 col-md-8 appear-animation align-self-center order-2 order-lg-2 order-md-2" data-appear-animation="fadeInLeftShorter" data-appear-animation-delay="300">
                    <div class="services-head-2 mb-3">@Helper.dilGetir("servis_baslik_2")</div>
                    <p class="metin mb-3">@Helper.dilGetir("servis_icerik_2")</p>
                </div>
            </div>
            <div class="row py-3" id="b2b-event-marketing">
                <div class="col-lg-8 col-md-8 appear-animation align-self-center order-2 order-lg-1 order-md-1" data-appear-animation="fadeInRightShorter" data-appear-animation-delay="300">
                    <div class="services-head-3 mb-3">@Helper.dilGetir("servis_baslik_3")</div>
                    <p class="metin mb-3">@Helper.dilGetir("servis_icerik_3")</p>
                </div>
                <div class="col-lg-4 col-md-4 appear-animation align-self-center order-1 order-lg-2 order-md-2" data-appear-animation="fadeInLeftShorter" data-appear-animation-delay="300">
                    <img src="/assets/img/services/b2b-event-marketing.gif" class="img-fluid mb-3 mt-3" alt="@Helper.dilGetir("servis_baslik_3")" />
                </div>
            </div>
            <div class="row py-3" id="360-creative-marketing">
                <div class="col-lg-4 col-md-4 appear-animation align-self-center order-1 order-lg-1 order-md-1" data-appear-animation="fadeInRightShorter" data-appear-animation-delay="300">
                    <img src="/assets/img/services/360-creative-marketing.gif" class="img-fluid mb-3 mt-3" alt="@Helper.dilGetir("servis_baslik_4")" />
                </div>
                <div class="col-lg-8 col-md-8 appear-animation align-self-center order-2 order-lg-2 order-md-2" data-appear-animation="fadeInLeftShorter" data-appear-animation-delay="300">
                    <div class="services-head-4 mb-3">@Helper.dilGetir("servis_baslik_4")</div>
                    <p class="metin mb-3">@Helper.dilGetir("servis_icerik_4")</p>
                </div>
            </div>
            <div class="row py-3" id="strategic-consultancy">
                <div class="col-lg-8 col-md-8 appear-animation align-self-center order-2 order-lg-1 order-md-1" data-appear-animation="fadeInRightShorter" data-appear-animation-delay="300">
                    <div class="services-head-5 mb-3">@Helper.dilGetir("servis_baslik_5")</div>
                    <p class="metin mb-3">@Helper.dilGetir("servis_icerik_5")</p>
                </div>
                <div class="col-lg-4 col-md-4 appear-animation align-self-center order-1 order-lg-2 order-md-2" data-appear-animation="fadeInLeftShorter" data-appear-animation-delay="300">
                    <img src="~/assets/img/services/strategic-consultancy.gif" class="img-fluid mb-3 mt-3" alt="@Helper.dilGetir("servis_baslik_5")" />
                </div>
            </div>
        </div>
    </section>
    <section id="fields" class="py-5 border-0 m-0 appear-animation" data-appear-animation="fadeIn">
        <div class="container my-3">
            <div class="row mb-5">
                <div class="col text-center appear-animation" data-appear-animation="fadeInUpShorter" data-appear-animation-delay="200">
                    <h2 class="font-weight-semi-bold mb-2">@Helper.dilGetir("menu_4")</h2>
                </div>
            </div>
            <div class="row">
                <div class="col text-center">
                    <div class="hopCircleContainer">
                        <div class="appear-animation circle-title" data-appear-animation="rotateIn" data-appear-animation-delay="100">@Helper.dilGetir("fields_1")</div>
                        <div class="appear-animation circle-title" data-appear-animation="rotateIn" data-appear-animation-delay="200">@Helper.dilGetir("fields_2")</div>
                        <div class="appear-animation circle-title" data-appear-animation="rotateIn" data-appear-animation-delay="300">@Helper.dilGetir("fields_3")</div>
                        <div class="appear-animation circle-title" data-appear-animation="rotateIn" data-appear-animation-delay="400">@Helper.dilGetir("fields_4")</div>
                        <div class="appear-animation circle-title" data-appear-animation="rotateIn" data-appear-animation-delay="500">@Helper.dilGetir("fields_5")</div>
                        <div class="appear-animation circle-title" data-appear-animation="rotateIn" data-appear-animation-delay="600">@Helper.dilGetir("fields_6")</div>
                        <div class="appear-animation circle-title" data-appear-animation="rotateIn" data-appear-animation-delay="700">@Helper.dilGetir("fields_7")</div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section id="contact" class="border-0 m-0 appear-animation" data-appear-animation="fadeIn">
        <div class="container my-3">
            <div class="row mb-5">
                <div class="col text-center appear-animation" data-appear-animation="fadeInUpShorter" data-appear-animation-delay="200">
                    <h2 class="font-weight-semi-bold mb-2">@Helper.dilGetir("menu_5")</h2>
                </div>
            </div>
        </div>
    </section>
    <footer id="footer" class="mt-0">
        <div class="container">
            <div class="row py-5">
                <div class="col-lg-4 mt-2 mb-2 text-xl-start text-lg-start text-md-center text-center appear-animation" data-appear-animation="fadeInRightShorter" data-appear-animation-delay="200">
                    <a href="/." title="@Helper.dilGetir("logo_title")"><img alt="@Helper.dilGetir("logo_title")" width="222" height="80" src="/assets/img/footer-logo.svg" class="mb-4" /></a>
                    <p class="mb-4">@Helper.dilGetir("footer_kisa")</p>
                    <a href="mailto:info@apostropheent.com" title="@Helper.dilGetir("email")">info@ApostropheEnt.com</a>
                    <ul class="footer-social-icons social-icons social-icons-clean mb-5 mt-4">
                        <li><a target="_blank" title="@Helper.dilGetir("instagram")" href="https://www.instagram.com/apostropheentertainment"><img src="/assets/img/instagram.svg" height="20" alt="@Helper.dilGetir("instagram")" /></a></li>
                        <li><a target="_blank" title="@Helper.dilGetir("linkedin")" href="https://www.linkedin.com/company/apostrophe-entertainment"><img src="/assets/img/linkedin.svg" height="20" alt="@Helper.dilGetir("linkedin")" /></a></li>
                    </ul>
                </div>
                <div class="col-lg-4 mt-2 mb-2 text-center appear-animation" data-appear-animation="fadeInUpShorter" data-appear-animation-delay="200">
                    <h5 class="text-5 text-transform-uppercase font-weight-semibold text-color-light mb-3">@Helper.dilGetir("footer_adres")</h5>
                    <div class="mb-3 mt-2">
                        <h5 class="text-4 text-transform-none font-weight-semibold text-color-light mb-1">London</h5>
                        <p class="mb-1 font-light">36 Shoreditch High Street, E1 6JJ</p>
                        @*<a href="tel:+447769493626" title="@Helper.dilGetir("telefon")">+44 7769 4936 26</a>*@
                    </div>
                    <div class="mb-3">
                        <h5 class="text-4 text-transform-none font-weight-semibold text-color-light mb-1">Paris</h5>
                        <p class="mb-1 font-light">18 Rue Pavée, 75004</p>
                        @*<a href="tel:+33769368266" title="@Helper.dilGetir("telefon")">+33 7 69 36 82 66</a>*@
                    </div>
                    <div class="mb-5">
                        <h5 class="text-4 text-transform-none font-weight-semibold text-color-light mb-1">Istanbul</h5>
                        <p class="mb-1 font-light">33 Sıraselviler St, Cihangir</p>
                        <a href="tel:+905309526649" title="@Helper.dilGetir("telefon")">+90 530 952 66 49</a>
                    </div>
                </div>
                <div class="col-lg-4 mt-2 mb-2 text-xl-end text-lg-end text-md-center text-center appear-animation" data-appear-animation="fadeInLeftShorter" data-appear-animation-delay="200">
                    <h5 class="text-5 text-transform-uppercase font-weight-semibold text-color-light mb-3">@Helper.dilGetir("menu_3")</h5>
                    <p class="mb-1 mt-2"><a data-hash data-hash-offset="0" data-hash-offset-lg="68" href="#strategic-communications" title="@Helper.dilGetir("servis_baslik_1")">@Helper.dilGetir("servis_baslik_1")</a></p>
                    <p class="mb-1"><a data-hash data-hash-offset="0" data-hash-offset-lg="68" href="#digital-marketing" title="@Helper.dilGetir("servis_baslik_2")">@Helper.dilGetir("servis_baslik_2")</a></p>
                    <p class="mb-1"><a data-hash data-hash-offset="0" data-hash-offset-lg="68" href="#b2b-event-marketing" title="@Helper.dilGetir("servis_baslik_3")">@Helper.dilGetir("servis_baslik_3")</a></p>
                    <p class="mb-1"><a data-hash data-hash-offset="0" data-hash-offset-lg="68" href="#360-creative-marketing" title="@Helper.dilGetir("servis_baslik_4")">@Helper.dilGetir("servis_baslik_4")</a></p>
                    <p class="mb-1"><a data-hash data-hash-offset="0" data-hash-offset-lg="68" href="#strategic-consultancy" title="@Helper.dilGetir("servis_baslik_5")">@Helper.dilGetir("servis_baslik_5")</a></p>
                </div>
            </div>
        </div>
        <div class="footer-copyright footer-copyright-style-2">
            <div class="container py-3">
                <div class="row">
                    <div class="col-lg-7 d-flex align-items-center justify-content-center justify-content-lg-start mb-4 mb-lg-0">
                        <p class="fcopy">@Helper.dilGetir("footer_copy")</p>
                    </div>
                    <div class="col-lg-5 d-flex align-items-center justify-content-center justify-content-lg-end">
                        <a href="https://www.kronomondo.com" target="_blank" title="Kronomondo"><img src="/assets/img/kronomondo.svg" height="18" alt="Kronomondo" /></a>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <script src="/assets/js/theme-core.js"></script>
    <script src="/assets/js/theme.js"></script>    
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-T1V637LFRT"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-T1V637LFRT');
    </script>
</body>
</html>